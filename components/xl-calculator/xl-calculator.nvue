}
.calculator-button {
	width: 360rpx;
	display: flex;
	flex-direction: row;
}
.calculator-button-left {
	width: 360rpx;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.calculator-button-left-a {
	position: relative;
	width: 120rpx;
	height: 40rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	/* background-color: #ffffff; */
}
.calculator-button-left-aview {
	width: 120rpx;
