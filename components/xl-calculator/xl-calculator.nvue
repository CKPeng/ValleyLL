	margin-top: 10rpx;
	min-height: 40rpx;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
.calculator-view-top-b1 {
	/* width: 330rpx; */
	/* white-space: pre-wrap; */
	word-wrap: break-word;
